{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "XNUVA localisation identity manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "project_id",
        "project_name",
        "application_name",
        "organisation",
        "ticker",
        "base_unit_singular",
        "base_unit_plural",
        "executables",
        "payment_uri_label",
        "fallback_language"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "project_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "project_name": {
            "type": "string",
            "minLength": 1
        },
        "application_name": {
            "type": "string",
            "minLength": 1
        },
        "organisation": {
            "type": "string",
            "minLength": 1
        },
        "ticker": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,10}$"
        },
        "base_unit_singular": {
            "type": "string",
            "minLength": 1
        },
        "base_unit_plural": {
            "type": "string",
            "minLength": 1
        },
        "executables": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "launcher",
                "daemon",
                "cli",
                "gui",
                "wallet",
                "transaction",
                "utility"
            ],
            "properties": {
                "launcher": {"type": "string", "minLength": 1},
                "daemon": {"type": "string", "minLength": 1},
                "cli": {"type": "string", "minLength": 1},
                "gui": {"type": "string", "minLength": 1},
                "wallet": {"type": "string", "minLength": 1},
                "transaction": {"type": "string", "minLength": 1},
                "utility": {"type": "string", "minLength": 1}
            }
        },
        "payment_uri_label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*:$"
        },
        "fallback_language": {
            "const": "en"
        }
    }
}
